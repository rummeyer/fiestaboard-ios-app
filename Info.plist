<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Plain http only to the home network or a VPN: the app itself refuses
	     http to any other address (FiestaBoardAPI.isLocal). -->
	<!-- FiestaBoard's own typefaces, both under the SIL Open Font License. -->
	<key>UIAppFonts</key>
	<array>
		<string>Archivo.ttf</string>
		<string>SplineSansMono.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
